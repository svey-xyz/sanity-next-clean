{
  "name": "sanity-template-nextjs-clean",
  "description": "Next.js + Sanity: A Powerful Website Starter with Real-time Visual Editing",
  "keywords": [
    "Sanity",
    "Next.js",
    "Headless CMS",
    "Visual Editing",
    "Live Content API (LCAPI)",
    "Real-time"
  ],
  "homepage": "https://github.com/sanity-io/sanity-template-nextjs-clean#readme",
  "bugs": {
    "url": "https://github.com/sanity-io/sanity-template-nextjs-clean/issues"
  },
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "clean": "rm -rf node_modules */node_modules package-lock.json */package-lock.json **/dist **/.next **/.vercel **/.turbo **/.cache **/.temp **/tmp",
    "dev": "npx run-p --print-label dev:*",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "import-sample-data": "cd studio && sanity dataset import sample-data.tar.gz --dataset production --replace",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "tsc -p tsconfig.json && npm run type-check --workspaces"
  },
  "prettier": "@sanity/prettier-config",
  "overrides": {
    "@sanity/cli": "7.13.0"
  },
  "dependencies": {
    "@sanity/blueprints": "^0.23.0",
    "@sanity/functions": "^1.4.0",
    "@svey-xyz/simple-shader-component": "^1.3.1"
  },
  "devDependencies": {
    "@sanity/prettier-config": "^3.0.0",
    "@types/node": "^22.19.17",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.6",
    "shadcn": "^4.15.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "msw@2.14.6": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
